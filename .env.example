# Copia este archivo a .env.local y rellénalo. Nunca subas .env.local al repo.
# En Vercel, las variables de Supabase y Blob las crean sus integraciones.
# Para traerlas a local: `npx vercel env pull .env.local`.

# --- Supabase (Postgres) ---
# Pooler en modo transacción (puerto 6543): la usa la app.
POSTGRES_URL=
# Conexión sin pooler de transacción (puerto 5432): la usan las migraciones.
POSTGRES_URL_NON_POOLING=
# Opcional: certificado de Supabase para verificar la conexión SSL.
DATABASE_CA_CERT=

# Alternativa sin Supabase (Postgres local o CI). Solo se usa si POSTGRES_URL está vacía.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# --- Vercel Blob (fotos) ---
# En desarrollo es opcional: sin token se guardan en public/dev-uploads.
BLOB_READ_WRITE_TOKEN=

# Secreto que Vercel envía al cron de caducidad (obligatorio en producción, 16+ caracteres)
CRON_SECRET=

# URL pública del sitio (sin barra final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Logs (opcionales, ver docs/LOGGING.md) ---
# LOG_LEVEL=debug          # debug | info | warn | error | silent
# LOG_FORMAT=pretty        # json | pretty
# LOG_DB_QUERIES=true      # registra cada consulta SQL (sin parámetros)

# --- Cuentas (Better Auth). Guía de configuración en README.md ---
# Secreto para firmar sesiones (obligatorio en producción, 32+ caracteres).
# Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL de la app para los callbacks y los enlaces de los emails. Si se deja vacía se usa
# NEXT_PUBLIC_SITE_URL (y en previews de Vercel, la URL del despliegue).
BETTER_AUTH_URL=

# Google: el botón solo aparece si están las dos.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple: el botón solo aparece si están las cuatro. La clave es el contenido del .p8
# (en una línea, con \n en los saltos de línea, o tal cual en Vercel).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Emails (Resend) ---
# Sin clave, en local los enlaces de los emails salen en la terminal de `npm run dev`.
RESEND_API_KEY=
# Remitente con un dominio verificado en Resend, p. ej. DogWhere <hola@tudominio.com>
EMAIL_FROM=

