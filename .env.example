# Copia este archivo a .env.local y rellénalo. Nunca subas .env.local al repo.
# En Vercel, DATABASE_URL y BLOB_READ_WRITE_TOKEN los inyectan las integraciones
# (Neon y Vercel Blob). Para traerlos a local: `vercel env pull .env.local`.

# Postgres (Neon, vía Vercel Marketplace). Usa la URL "pooled".
# En local también vale un Postgres en Docker: postgres://postgres:postgres@localhost:5432/postgres
DATABASE_URL=

# Vercel Blob (fotos). En desarrollo es opcional: sin token se guardan en public/dev-uploads
BLOB_READ_WRITE_TOKEN=

# Secreto que Vercel envía al cron de caducidad (obligatorio en producción, 16+ caracteres)
CRON_SECRET=

# URL pública del sitio (sin barra final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Fase 2: autenticación (Better Auth) ---
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
