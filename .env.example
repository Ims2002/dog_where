# Copia este archivo a .env.local y rellénalo. Nunca subas .env.local al repo.
# En Vercel, las variables de Supabase y Blob las crean sus integraciones.
# Para traerlas a local: `npx vercel env pull .env.local`.

# Alternativa sin Supabase (Postgres local o CI). Solo se usa si POSTGRES_URL está vacía.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# --- Vercel Blob (fotos) ---
# En desarrollo es opcional: sin token se guardan en public/dev-uploads.
BLOB_READ_WRITE_TOKEN=

# Secreto que Vercel envía al cron de caducidad (obligatorio en producción, 16+ caracteres)
CRON_SECRET=

# URL pública del sitio (sin barra final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Fase 2: autenticación ---
# (Supabase Auth o Better Auth, a decidir)

# --- Fase 3: Supabase base de datos ---
